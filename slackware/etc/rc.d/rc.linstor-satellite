#!/bin/sh
# /etc/rc.d/rc.satellite - start/stop the satellite daemon

# To change the default options, edit /etc/default/atd.
if [ -r /etc/default/linstor ]; then
  . /etc/default/linstor
fi

start_satellite() {
  if ! /usr/bin/pgrep --ns $$ -f linstore.core.Satellite 1> /dev/null 2> /dev/null ; then
    if [ -x /usr/share/linstor-server/bin/Satellite ]; then
      echo "Starting LINSTOR Satellite:  /usr/share/linstor-server/bin/Satellite $SATELLITE_OPTS"
      JAVA_HOME="${JAVA_HOME}" /usr/share/linstor-server/bin/Satellite $SATELLITE_OPTS >> /var/log/linstor/satellite 2>&1 &
    fi
  fi
}

stop_satellite() {
  echo "Stopping LINSTOR Satellite."
  /usr/bin/pkill --ns $$ -f linstor.core.Satellite 2> /dev/null
}

restart_satellite() {
  stop_satellite
  sleep 1
  start_satellite
}

case "$1" in
'start')
  start_satellite
  ;;
'stop')
  stop_satellite
  ;;
'restart')
  restart_satellite
  ;;
*)
  echo "usage $0 start|stop|restart"
esac
