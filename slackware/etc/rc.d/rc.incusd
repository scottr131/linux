#!/bin/sh
# /etc/rc.d/rc.incus - start/stop the incus daemon

# To change the default options, edit /etc/default/atd.
if [ -r /etc/default/incus ]; then
  . /etc/default/incus
fi

start_incus() {
  if ! /usr/bin/pgrep --ns $$ -f "^/usr/sbin/incusd" 1> /dev/null 2> /dev/null ; then
    if [ -x /usr/sbin/incusd ]; then
      echo "Starting incusd:  /usr/sbin/incusd $INCUSD_OPTS"
      PATH="/usr/local/bin:${PATH}" INCUS_UI="${INCUS_UI}" JAVA_HOME="${JAVA_HOME}" /usr/sbin/incusd $INCUSD_OPTS 1> /dev/null 2> /dev/null &
    fi
  fi
}

stop_incus() {
  pid=$(pgrep -f /usr/sbin/incusd)
  if [ -n "$pid" ]; then
    echo -n "Stopping incus."
    kill -PWR "$pid"

    timeout=300
    elapsed=0
    while pgrep -x incusd > /dev/null; do
      if (( elapsed >= timeout )); then
          echo ""
          echo "incusd didn't stop in time, sending SIGKILL"
          kill -9 "$pid"
          break
      fi
      sleep 1
      echo -n "."
    ((elapsed++))
    done
    echo ""
  else
    echo "Incus doesn't seem to be running."
  fi

}

restart_incus() {
  stop_incus
  sleep 1
  start_incus
}

case "$1" in
'start')
  start_incus
  ;;
'stop')
  stop_incus
  ;;
'restart')
  restart_incus
  ;;
*)
  echo "usage $0 start|stop|restart"
esac
